# 로컬 개발용 설정 예시. 필요하면 application-local.yml로 복사해서 쓴다 (.gitignore 대상).
# 실행: ./gradlew bootRun --args='--spring.profiles.active=local'
# 비밀값은 여기에 쓰지 말고 .env에 둔다.
app:
  mail:
    mode: log        # 메일 대신 인증번호를 서버 로그에 남긴다
  cookie:
    secure: false    # http://localhost에서 쿠키를 받기 위해

logging:
  level:
    com.oneblog: DEBUG
