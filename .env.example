# One Blog 환경변수
#
# 쓰는 법: 이 파일을 복사해 .env를 만들고 값을 채운다.
#   cp .env.example .env
# .env는 .gitignore로 제외되어 저장소에 올라가지 않는다 (constitution III).
# 애플리케이션은 저장소 루트의 .env를 자동으로 읽는다 (application.yml의 spring.config.import).
# 무작위 값 만들기: openssl rand -base64 48

# ── DB (MySQL 8.4) ─────────────────────────────────────
# 개발 DB는 Crowfoot이 발급한 MySQL (ERD 문서와 연결된 DB).
# 아이디·비밀번호는 Crowfoot 화면의 데이터베이스 탭에서 확인한다.
DB_HOST=s4.java21.net
DB_PORT=13306
DB_NAME=cf_u36_d1
DB_USERNAME=
DB_PASSWORD=

# ── 테스트 DB (./gradlew test) ──────────────────────────
# 테스트는 실행할 때마다 회원·인증 테이블을 비운다. 반드시 위 개발 DB와 다른 DB를 쓴다.
# 기본은 로컬 MySQL(localhost:3306)의 one_blog_test DB, one_blog 계정.
# 로컬 MySQL에서 만든 one_blog 계정의 비밀번호를 넣는다 (Crowfoot 계정이 아님).
TEST_DB_USERNAME=one_blog
TEST_DB_PASSWORD=
# 다른 곳의 DB를 쓰려면 주석을 풀고 채운다.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=3306
# TEST_DB_NAME=one_blog_test

# ── 로그인 (JWT, SEC-04) ────────────────────────────────
# Access Token·가입 티켓 서명 키. 32바이트 이상 무작위 문자열. 바꾸면 모든 로그인이 풀린다.
JWT_SECRET=

# ── 이메일 인증번호 해시 키 (USR-02) ─────────────────────
# 인증번호를 DB에 원문 대신 HMAC으로 저장할 때 쓰는 키. 무작위 문자열.
CODE_PEPPER=

# ── 메일 발송 (Gmail SMTP, D-69) ────────────────────────
# log: 메일을 보내지 않고 인증번호를 서버 로그에 찍는다 (개발용)
# smtp: Gmail로 실제 발송한다 (아래 두 값 필요)
# 받는 사람은 가입 화면에서 사용자가 입력한 이메일이다. 아래는 "보내는 쪽" 계정이다.
MAIL_MODE=log
# 보내는 사람 Gmail 계정 (서비스 대표 메일, 예: oneblog.noreply@gmail.com).
# Gmail SMTP에 로그인하는 아이디이자 메일의 보낸 사람 주소로 쓴다.
MAIL_USERNAME=
# Gmail 앱 비밀번호 16자리 (Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호). 일반 Gmail 비밀번호가 아니다.
MAIL_PASSWORD=

# ── 쿠키 ────────────────────────────────────────────────
# 로컬(http://localhost)은 false, 운영(HTTPS)은 반드시 true (SEC-10)
COOKIE_SECURE=false

# ── 이후 기능에서 추가할 값 (지금은 비워 둠) ────────────
# Cloudflare Turnstile CAPTCHA (SEC-13, 로드맵 015)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 카카오톡 공유 JavaScript 키 (6.2, 2차)
# KAKAO_JS_KEY=
